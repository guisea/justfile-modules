# Env vars for docker.just. Append into .env in your repo root (next to your justfile)
# and fill in the values you need. Add `set dotenv-load` to the top of your justfile so
# `just` loads it - module variables are resolved from the real OS environment, so
# `export X := "..."` in the justfile itself does NOT reach docker.just; a real env var
# (shell or .env) does.
#
#   cat justfile-modules/.env.example.docker >> .env
#
# See docker.md for the full writeup of what each recipe does with these.

# --- required ---
IMAGE=myapp

# Single-registry setup: just set REGISTRY.
REGISTRY=ghcr.io/cybercinch

# Multi-registry setup (e.g. Docker Hub + ECR): set REGISTRIES instead, comma-separated.
# push/buildx-push tag+push to every entry in one go. Leave unset/commented if you only
# ever push to one registry - it falls back to REGISTRY above.
#REGISTRIES=docker.io/myuser,123456789012.dkr.ecr.us-east-1.amazonaws.com

# --- optional (shown with their defaults) ---
#DOCKERFILE=Dockerfile
#CONTEXT=.
#PLATFORMS=linux/amd64,linux/arm64

# --- auth (used at login time, not by build/push) ---
# Token-based registries (Docker Hub, GHCR, Harbor, ...) - read by `docker::login`.
# Never commit the actual token; this only names which env var holds it.
#REGISTRY_TOKEN=

# ECR via AWS SSO - read by `docker::login-ecr`. Run `aws sso login --profile
# my-sso-profile` yourself first; the recipe won't trigger the browser flow.
#AWS_REGION=us-east-1
#AWS_PROFILE=my-sso-profile
